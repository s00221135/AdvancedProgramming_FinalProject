<Window x:Class="AdvancedProgramming_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Release Tracker" Height="460" Width="650">
    <DockPanel>
        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Add-record area -->
            <Grid Margin="10,0,-10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,10,6,110">Song Title:</TextBlock>
                <TextBox  x:Name="txtTitle"  Grid.Column="1" Margin="0,10,80,115"/>

                <TextBlock Grid.Column="0" Margin="10,42,175,81" RenderTransformOrigin="0.517,-0.678" Grid.ColumnSpan="2">Artist:</TextBlock>
                <TextBox  x:Name="txtArtist" Margin="0,42,80,89" Grid.Column="1"/>

                <TextBlock Grid.Column="0" Margin="8,74,160,40" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="0.369"/>
                            <RotateTransform/>
                            <TranslateTransform Y="0.216"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>Release Year:</TextBlock>
                <TextBox  x:Name="txtYear"   Grid.Column="1" Margin="0,69,80,62"/>

                <Button x:Name="btnSaveIso" Grid.Column="2" Grid.Row="0"
                        Content="Save to Storage" Click="btnSaveIso_Click" Margin="0,7,0,111"/>
                <Button x:Name="btnLoadIso" Grid.Column="2"
                        Content="Load from Storage" Click="btnLoadIso_Click" Margin="0,55,0,62"/>
            </Grid>

            <!-- Search controls -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 12 0 6">
                <TextBlock Margin="0 4 6 0">Search Term/Year:</TextBlock>
                <TextBox x:Name="txtSearch" Width="160" Margin="0 0 10 0"/>
                <Button x:Name="btnStart"  Content="Start Search"   Click="btnStart_Click" Margin="0 0 10 0"/>
                <Button x:Name="btnCancel" Content="Cancel Search"  Click="btnCancel_Click"/>
            </StackPanel>

            <!-- Progress + results -->
            <StackPanel Grid.Row="2">
                <ProgressBar x:Name="progress" Height="18" Margin="0 0 0 10"/>
                <ListBox    x:Name="lstResults"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
